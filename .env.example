# Deployment environment consumed by docker-compose.yml.
# Copy outside the repository or inject with the deployment secret manager.

AWCENTER_RELEASE=replace-with-release-identifier
AWCENTER_IMAGE=registry.example.com/aw-center@sha256:replace-with-resolved-image-digest
AWCENTER_HOST=awcenter.example.com
SECRET_KEY=replace-with-a-long-random-production-secret
DATABASE_URL=postgres://awcenter:replace-password@database:5432/awcenter
POSTGRES_DB=awcenter
POSTGRES_USER=awcenter
POSTGRES_PASSWORD=replace-password
# 24-128 characters from A-Z, a-z, 0-9, dot, underscore, tilde, and hyphen.
REDIS_PASSWORD=replace-with-a-url-safe-redis-password
MODEL_DIRECTORY=/srv/awcenter/models
# MODEL_DIRECTORY must contain templates/*.docx and the four model directories
# named below; the container mounts the whole tree read-only at /app/models.
TLS_CERTIFICATE_FILE=/srv/awcenter/tls/tls.crt
TLS_PRIVATE_KEY_FILE=/srv/awcenter/tls/tls.key

LOG_LEVEL=INFO
DATABASE_CONN_MAX_AGE=60
JOB_ARTIFACT_RETENTION_DAYS=30

JIRA_ENABLED=false
JIRA_URL=https://jira.example.com
JIRA_DEFAULT_PROJECT_KEY=CHN
JIRA_SESSION_ENCRYPTION_KEY=

DOCPROOF_ENABLED=false
DOCPROOF_URL=https://docproof.example.com
DOCPROOF_USERNAME=
DOCPROOF_PASSWORD=
TEAMCENTER_ENABLED=false
TEAMCENTER_BASE_URL=https://teamcenter.example.com/tc
TEAMCENTER_USERNAME=
TEAMCENTER_PASSWORD=

DOORS_ENABLED=false
WINDOWS_BRIDGE_ENABLED=false
# Set to windows-bridge only when WINDOWS_BRIDGE_ENABLED=true.
COMPOSE_PROFILES=
WINDOWS_BRIDGE_TRUST_PROXY_HEADERS=false
WINDOWS_BRIDGE_CLIENT_FINGERPRINTS=
WINDOWS_BRIDGE_CLIENT_SUBJECTS=
WINDOWS_BRIDGE_CA_FILE=
AWCENTER_BRIDGE_HOST=
WINDOWS_BRIDGE_PORT=8443

ASSESSMENT_API_URL=
ASSESSMENT_API_ALLOWED_HOSTS=

AWCENTER_MAIL_TRANSPORT=disabled
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=awcenter@example.com
