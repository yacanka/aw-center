# Production deployment environment consumed by docker-compose.yml.
#
# This file documents names and shapes only: it is intentionally rejected by
# scripts/deployment_preflight.py until every placeholder and runtime path is
# replaced. Keep the real file outside the checkout with owner-only permissions,
# or inject the same values with the deployment secret manager. Never commit it.

# Immutable release identity and public origin
AWCENTER_RELEASE=replace-with-release-identifier
AWCENTER_IMAGE=registry.example.com/aw-center@sha256:replace-with-resolved-image-digest
AWCENTER_HOST=awcenter.example.com

# Core application and state secrets
# SECRET_KEY must be a unique, random value of at least 50 characters.
SECRET_KEY=replace-with-a-long-random-production-secret
# DATABASE_URL must target the Compose service named "database". Its decoded
# username, database name, and password must match the POSTGRES_* values below.
# Percent-encode reserved URL characters in DATABASE_URL.
DATABASE_URL=postgres://awcenter:replace-password@database:5432/awcenter
POSTGRES_DB=awcenter
POSTGRES_USER=awcenter
POSTGRES_PASSWORD=replace-password
# Use 24-128 URL-safe characters: A-Z, a-z, 0-9, dot, underscore, tilde, hyphen.
REDIS_PASSWORD=replace-with-a-url-safe-redis-password

# Host paths mounted read-only into containers. Keep AI weights and operator-managed
# DOCX templates outside the source checkout and in separate directories.
AI_MODEL_DIRECTORY=/srv/awcenter/ai-models
DOCUMENT_TEMPLATE_DIRECTORY=/srv/awcenter/document-templates
TLS_CERTIFICATE_FILE=/srv/awcenter/tls/tls.crt
# The preflight requires the private key to have no group/other permission bits.
TLS_PRIVATE_KEY_FILE=/srv/awcenter/tls/tls.key

# Operational tuning
LOG_LEVEL=INFO
DATABASE_CONN_MAX_AGE=60
JOB_ARTIFACT_RETENTION_DAYS=30

# JIRA: JIRA_SESSION_ENCRYPTION_KEY must be a valid Fernet key when enabled.
JIRA_ENABLED=false
JIRA_URL=https://jira.example.com
JIRA_DEFAULT_PROJECT_KEY=CHN
JIRA_SESSION_ENCRYPTION_KEY=

# DocProof: username and password are required when enabled.
DOCPROOF_ENABLED=false
DOCPROOF_URL=https://docproof.example.com
DOCPROOF_USERNAME=
DOCPROOF_PASSWORD=

# Teamcenter: this deployment uses password authentication.
TEAMCENTER_ENABLED=false
TEAMCENTER_BASE_URL=https://teamcenter.example.com/tc
TEAMCENTER_SERVICE_ROOT=RestServices
TEAMCENTER_AUTH_MODE=password
TEAMCENTER_USERNAME=
TEAMCENTER_PASSWORD=

# The native Windows DOORS runner connects only through the host loopback port.
# Generate DOORS_RUNNER_TOKEN with secrets.token_urlsafe(32), store the real value
# outside the repository, and provision the same value to the Windows runner.
DOORS_ENABLED=false
DOORS_RUNNER_TOKEN=
DOORS_RUNNER_PORT=8765

# Optional assessment upstream. If URL is set, list its exact hostname here.
ASSESSMENT_API_URL=
ASSESSMENT_API_ALLOWED_HOSTS=

# Mail is consumed only by notification-worker. For django transport, enable
# exactly one of TLS or SSL and provide credentials through the secret manager.
AWCENTER_MAIL_TRANSPORT=disabled
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=awcenter@example.com
