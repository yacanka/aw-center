{
  "name": "aw-center",
  "version": "1.1.0",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-budget.mjs && node scripts/postbuild.js",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,vue}\" \"*.{json,ts}\" \"scripts/**/*.{js,mjs,ts}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,vue}\" \"*.{json,ts}\" \"scripts/**/*.{js,mjs,ts}\" \"e2e/**/*.ts\"",
    "test:commands": "node --experimental-strip-types --test scripts/test-command-search.mjs",
    "test:access": "node --experimental-strip-types --test scripts/test-route-access.mjs",
    "test:errors": "node --experimental-strip-types --test scripts/test-api-errors.mjs",
    "test:bundle-path": "node --test scripts/test-bundle-path.mjs scripts/test-mermaid-renderer-output.mjs scripts/test-mermaid-renderer-cache.mjs",
    "test:stores": "node --test scripts/test-store-boundaries.mjs",
    "test:tables": "node --experimental-strip-types --test scripts/test-table-filters.mjs",
    "test:ui-registration": "node --test scripts/test-naive-registration.mjs",
    "test:uploads": "node --experimental-strip-types --test scripts/test-uploads.mjs",
    "test:outlook": "node --experimental-strip-types --test scripts/test-outlook-attachments.mjs",
    "test:dcc": "node --test scripts/test-dcc-jobs.mjs",
    "test:compdoc": "vitest run scripts/test-compdoc-imports.test.mjs",
    "test:people-search": "node --test scripts/test-people-search.mjs",
    "test:home": "node --experimental-strip-types --test scripts/test-home-dashboard.mjs",
    "test:jobs": "node --test scripts/test-page-jobs.mjs",
    "test:unit": "vitest run src",
    "test:ci": "npm run test:toolchain && npm run test:bundle-path && npm run test:unit && npm run test:commands && npm run test:access && npm run test:errors && npm run test:stores && npm run test:tables && npm run test:ui-registration && npm run test:uploads && npm run test:outlook && npm run test:dcc && npm run test:compdoc && npm run test:people-search && npm run test:home && npm run test:jobs && npm run test:reports",
    "test:e2e": "playwright test",
    "serve": "vite preview",
    "predev": "node scripts/build-mermaid-renderer.mjs --dev",
    "prebuild": "node scripts/build-mermaid-renderer.mjs",
    "pretest:unit": "node scripts/build-mermaid-renderer.mjs",
    "test:reports": "vitest run scripts/test-management-reports.test.mjs",
    "test:toolchain": "node --test scripts/test-toolchain-dependencies.mjs"
  },
  "dependencies": {
    "@vicons/fluent": "^0.13.0",
    "axios": "^1.21.1",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "markdown-it": "^14.3.3",
    "mermaid": "12.3.0",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.45",
    "vue-audio-visual": "^3.0.11",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vfonts": "^0.1.0",
    "vite": "^8.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "axios": "^1.21.1",
    "esbuild": "^0.28.1",
    "follow-redirects": "^1.16.3",
    "form-data": "^4.0.6",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "markdown-it": "^14.3.3",
    "nanoid": "^3.3.18",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.26",
    "vite": "^8.3.7",
    "glob": "^14.0.4",
    "minimatch": "^11.0.6"
  }
}
