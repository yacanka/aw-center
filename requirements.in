# Backend Python dependencies for AW Center.
# Target runtime: CPython 3.11, 64-bit.
# Resolver-friendly Python 3.11 set.
# Updated after pip conflict around extract-msg + beautifulsoup4.

# Packaging compatibility
setuptools

# Core web framework
# Django 6.x requires Python >=3.12; stay on Django 5.2 LTS for Python 3.11.
Django
djangorestframework
django-cors-headers
django-simple-history
django-environ
django-extensions
whitenoise
gunicorn
uvicorn; sys_platform == "win32"
psycopg[binary]
redis
cryptography

# Integrations and HTTP clients
jira
requests

# Office, PDF, and document processing
# Keep bs4 below 4.15 because extract-msg currently conflicts with beautifulsoup4>=4.15.
beautifulsoup4
docx2txt
docxtpl
extract-msg
# Python 3.11 safe scientific stack. Avoid speculative/future NumPy/Pandas lines.
numpy
openpyxl
pandas
pdfplumber
Pillow
pypdf
reportlab
python-dateutil
python-docx

# Approved NLP set for CPython 3.11 and the corporate package repository.
sentence-transformers==5.6.0
transformers[sentencepiece]==5.22.1
torch==2.13.0
huggingface-hub==2.2.0
sentencepiece==0.2.2
# Keep the validated transitive versions available in the corporate repository.
tokenizers==0.23.3
hf-xet==1.8.0
httpx2==2.16.0
httpcore2==2.16.0
truststore==0.10.5
protobuf==7.36.2

# Windows-only automation used by DOORS, Outlook, and PowerPoint helpers
pywin32; sys_platform == "win32"
WMI; sys_platform == "win32"
