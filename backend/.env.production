# Windows-native production template for `python launcher.py prod`.
# Copy this file to:
# C:/Users/<user>/AppData/Local/AWCenter/config/production.env
# Replace every placeholder there. Never store real secrets in this tracked file.

AWCENTER_DEPLOYMENT_MODE=windows-native
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=False
LOG_LEVEL=INFO
IPV4_ADDRESS=192.0.2.10
PORT=443
ALLOWED_HOSTS=192.0.2.10
ALLOW_ALL_DEBUG_HOSTS=False

# Development and production must never share these paths. SQLite must stay on
# a local NTFS disk; do not place it in OneDrive or on a network share.
DATABASE_URL=sqlite:///C:/Users/REPLACE_ME/AppData/Local/AWCenter/state/production/db.sqlite3
DATABASE_CONN_MAX_AGE=0
SQLITE_BUSY_TIMEOUT_SECONDS=30
CACHE_URL=
CACHE_DIRECTORY=C:/Users/REPLACE_ME/AppData/Local/AWCenter/state/production/cache
PRIVATE_MEDIA_ROOT=C:/Users/REPLACE_ME/AppData/Local/AWCenter/state/production/private-media
MEDIA_ROOT=C:/Users/REPLACE_ME/AppData/Local/AWCenter/state/production/media
STATIC_ROOT=C:/Users/REPLACE_ME/AppData/Local/AWCenter/state/production/static

CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=https://192.0.2.10
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_PROXY_HEADERS=False
TRUSTED_PROXY_COUNT=0

JIRA_ENABLED=False
JIRA_URL=https://jira.example.com
JIRA_DEFAULT_PROJECT_KEY=CHN
JIRA_SESSION_TTL_SECONDS=3600
JIRA_SESSION_ENCRYPTION_KEY=

DOCPROOF_ENABLED=False
DOCPROOF_URL=https://docproof.example.com
DOCPROOF_VERIFY_SSL=True
DOCPROOF_CERTIFICATE_FILE=C:/Users/REPLACE_ME/AppData/Local/AWCenter/certificates/docproof-ca.crt
DOCPROOF_USERNAME=
DOCPROOF_PASSWORD=
DOCPROOF_MAX_RESPONSE_BYTES=10485760

NUMARATOR_ENABLED=False
NUMARATOR_BASE_URL=https://numarator.example.com
NUMARATOR_API_KEY=
NUMARATOR_CREDENTIAL_ID=aw-center-production-v1
NUMARATOR_VERIFY_SSL=True
NUMARATOR_PROJECT_FORMATS={"ozgur":"COVER_PAGE"}

TEAMCENTER_ENABLED=False
TEAMCENTER_BASE_URL=https://teamcenter.example.com/tc
TEAMCENTER_SERVICE_ROOT=RestServices
TEAMCENTER_AUTH_MODE=password
TEAMCENTER_USERNAME=
TEAMCENTER_PASSWORD=
TEAMCENTER_GROUP=
TEAMCENTER_ROLE=
TEAMCENTER_VERIFY_SSL=True
TEAMCENTER_CONNECT_TIMEOUT_SECONDS=10
TEAMCENTER_READ_TIMEOUT_SECONDS=60
TEAMCENTER_MAX_RESPONSE_BYTES=10485760

# DOORS runs in the single Windows job worker.
DOORS_ENABLED=False
DOORS_EXECUTABLE=C:/IBM/DOORS/bin/doors.exe
DOORS_DATABASE=
DOORS_OLE_PROG_ID=DOORS.Application
DOORS_PREFER_ACTIVE_INSTANCE=True
DOORS_AUTO_START_CLIENT=False
DOORS_STARTUP_TIMEOUT_SECONDS=30
DOORS_RUN_TIMEOUT_SECONDS=120
DOORS_MAX_RESULT_BYTES=10485760
DOORS_RESULT_MODE=file
DOORS_WORKER_LOCK_FILE=C:/Users/REPLACE_ME/AppData/Local/AWCenter/state/doors-worker.lock
ASSESSMENT_API_URL=
ASSESSMENT_API_ALLOWED_HOSTS=
ASSESSMENT_API_CONNECT_TIMEOUT_SECONDS=5
ASSESSMENT_API_READ_TIMEOUT_SECONDS=60
ASSESSMENT_API_MAX_RESPONSE_BYTES=1048576

AWCENTER_MAIL_TRANSPORT=disabled
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=awcenter@example.com

AWCENTER_MAX_DOCUMENT_UPLOAD_BYTES=52428800
AWCENTER_MAX_IMAGE_UPLOAD_BYTES=10485760
AWCENTER_MAX_MEDIA_UPLOAD_BYTES=524288000
AWCENTER_ABSOLUTE_MAX_UPLOAD_BYTES=629145600
AWCENTER_MAX_ATTACHMENT_UPLOAD_BYTES=104857600
AWCENTER_MAX_ARCHIVE_EXPANDED_BYTES=262144000
AWCENTER_MAX_ARCHIVE_ENTRIES=5000
AWCENTER_MAX_COMPDOC_IMPORT_ROWS=10000
AWCENTER_MAX_COMPDOC_EXPORT_ROWS=10000
AWCENTER_MAX_PANEL_IMPORT_ROWS=10000
PANEL_IMPORT_PREVIEW_TTL_SECONDS=900
COMPDOC_IMPORT_PREVIEW_TTL_SECONDS=900
COMPDOC_NOTIFICATION_POLL_SECONDS=300
COMPDOC_NOTIFICATION_BATCH_SIZE=25
COMPDOC_NOTIFICATION_LOCK_SECONDS=900
COMPDOC_NOTIFICATION_RETRY_SECONDS=3600

JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=2
JOB_WORKER_STALE_SECONDS=10
JOB_EXECUTION_TIMEOUT_SECONDS=900
JOB_JSON_MAX_INPUT_BYTES=1048576
JOB_MAX_OUTPUT_BYTES=1073741824
JOB_ARTIFACT_RETENTION_DAYS=30
DCC_PREVIEW_TTL_SECONDS=900

FRONTEND_RESET_URL=https://192.0.2.10/app/login
FRONTEND_INVITATION_URL=https://192.0.2.10/app/invite
FRONTEND_DIST_DIR=C:/Users/REPLACE_ME/AppData/Local/AWCenter/releases/REPLACE_RELEASE/source/frontend/dist

FFMPEG_EXECUTABLE=ffmpeg
SOFFICE_BIN=soffice
PDFTOPPM_BIN=pdftoppm
MODEL_RUNTIME_DIR=C:/Users/REPLACE_ME/AppData/Local/AWCenter/assets/sets/REPLACE_ASSET_SET/ai-models
WORD_TRANSLATION_TR_EN_MODEL=C:/Users/REPLACE_ME/AppData/Local/AWCenter/assets/sets/REPLACE_ASSET_SET/ai-models/opus-mt-tr-en
WORD_TRANSLATION_EN_TR_MODEL=C:/Users/REPLACE_ME/AppData/Local/AWCenter/assets/sets/REPLACE_ASSET_SET/ai-models/opus-mt-en-tr
WORD_ANALYZER_BI_MODEL=C:/Users/REPLACE_ME/AppData/Local/AWCenter/assets/sets/REPLACE_ASSET_SET/ai-models/paraphrase-multilingual
WORD_ANALYZER_CROSS_MODEL=C:/Users/REPLACE_ME/AppData/Local/AWCenter/assets/sets/REPLACE_ASSET_SET/ai-models/ms-marco-cross-encoder
CUSTOM_TEMPLATE_DIR=C:/Users/REPLACE_ME/AppData/Local/AWCenter/assets/sets/REPLACE_ASSET_SET/document-templates
COVER_PAGE_TEMPLATE_PATH=C:/Users/REPLACE_ME/AppData/Local/AWCenter/assets/sets/REPLACE_ASSET_SET/document-templates/cover_page_template.docx
