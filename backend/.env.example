# Local development environment for Django and launcher.py.
#
# Setup:
#   cp backend/.env.example backend/.env
#
# backend/.env is ignored by Git, so machine-specific paths and local-only
# credentials may be added to the copied file. Process environment variables
# take precedence. Never reuse these development settings in production.

# Application and local network
# SECRET_KEY is intentionally omitted; DEBUG mode uses the built-in local-only key.
DEBUG=True
LOG_LEVEL=INFO
IPV4_ADDRESS=127.0.0.1
PORT=8000
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOW_ALL_DEBUG_HOSTS=True

# Local persistence. Empty CACHE_URL uses Django's in-process cache.
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=0
SQLITE_BUSY_TIMEOUT_SECONDS=30
CACHE_URL=
PRIVATE_MEDIA_ROOT=private_media

# Browser origins and development-only transport security
DEV_FRONTEND_PORT=5173
DEV_BACKEND_PORT=8000
DEV_SERVER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
TRUST_PROXY_HEADERS=False
TRUSTED_PROXY_COUNT=0
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False

# Integrations are opt-in. Fill credentials only in the ignored backend/.env.
JIRA_ENABLED=False
JIRA_URL=http://localhost:8080
JIRA_DEFAULT_PROJECT_KEY=CHN
JIRA_SESSION_ENCRYPTION_KEY=

DOCPROOF_ENABLED=False
DOCPROOF_URL=http://localhost:9000
DOCPROOF_VERIFY_SSL=False
DOCPROOF_USERNAME=
DOCPROOF_PASSWORD=

TEAMCENTER_ENABLED=False
TEAMCENTER_BASE_URL=
TEAMCENTER_SERVICE_ROOT=RestServices
TEAMCENTER_AUTH_MODE=password
TEAMCENTER_USERNAME=
TEAMCENTER_PASSWORD=

DOORS_ENABLED=False
DOORS_RUNNER_TOKEN=
DOORS_RUNNER_URL=http://127.0.0.1:8765
DOORS_RUNNER_CREDENTIAL_TARGET=AWCenter/DOORSRunner
ASSESSMENT_API_URL=
ASSESSMENT_API_ALLOWED_HOSTS=

# Local mail delivery remains disabled unless explicitly enabled.
AWCENTER_MAIL_TRANSPORT=disabled
DEFAULT_FROM_EMAIL=awcenter@localhost

FRONTEND_RESET_URL=http://localhost:5173/app/login
FRONTEND_INVITATION_URL=http://localhost:5173/app/invite

# Production does not use this file or launcher.py. Its canonical deployment
# template is the repository-root .env.example consumed by Docker Compose.
